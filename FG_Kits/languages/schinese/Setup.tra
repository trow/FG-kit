@10800005 = ~When this ability is activated, the Arsenal removes all cartridges.~
@10800006 = ~Check Cartridge~
@10800007 = ~When this ability is activated, the Arsenal lists off the active cartridges.~
@10800008 = ~Needle Cartridge loaded~
@10800009 = ~Flechette Cartridge loaded~
