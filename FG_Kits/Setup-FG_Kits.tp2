BACKUP ~FG_Kits\Backup~
AUTHOR ~Everyone's FailGeek~

ALWAYS
	INCLUDE ~FG_Kits\!BaseItems\fl#add_kit_ee.tpa~

	OUTER_SET "blank" = 0xffffffff //Variable - "blank": set to -1

	ACTION_IF GAME_IS ~bgee bg2ee eet~ THEN BEGIN //Detection - Game: Checks
		PRINT @112 //Detection - Game: Baldur's Gate 1/2
	END
		ELSE BEGIN
			ACTION_IF GAME_IS ~iwdee~ THEN BEGIN
				PRINT @113 //Detection - Game: Icewind Dale
			END
		END	

	ACTION_IF NOT VARIABLE_IS_SET "dr_state" THEN BEGIN //Detection - DR: Checks
		ACTION_IF NOT MOD_IS_INSTALLED ~DIVINE_REMIX/SETUP-DIVINE_REMIX.TP2~ ~100~ THEN BEGIN //Detection - DR: Check if Divine Remix is not installed
			OUTER_SET "dr_state" = 0 //Variable - "dr_state": set to DR not installed
			PRINT @121 //Detection - DR: Divine Remix is not Installed
		END
			ELSE BEGIN
				ACTION_IF NOT MOD_IS_INSTALLED ~DIVINE_REMIX/SETUP-DIVINE_REMIX.TP2~ ~1000~ THEN BEGIN //Detection - DR: Check if Divine Remix - Spheres is not installed
					OUTER_SET "dr_state" = 1 //Variable - "dr_state": set to DR installed
					PRINT @122 //Detection - DR: Divine Remix Installed
				END
					ELSE BEGIN
						OUTER_SET "dr_state" = 2 //Variable - "dr_state": set to DR Sphere System
						PRINT @123 //Detection - DR: DR Sphere System Installed
					END
			END
	END

	ACTION_IF NOT VARIABLE_IS_SET "rf_state" THEN BEGIN //Detection - Refinements: Checks
		ACTION_IF NOT MOD_IS_INSTALLED ~REFINEMENTS/SETUP-REFINEMENTS.TP2~ ~10~ THEN BEGIN //Detection - Refinements: Check if Refinements is not installed
			OUTER_SET "rf_state" = 0 //Variable - "rf_state": set to RF not installed
			PRINT @131 //Detection - Refinements: Refinements is not Installed
		END
			ELSE BEGIN
				OUTER_SET "rf_state" = 1 //Variable - "rf_state": set to RF installed
				PRINT @132 //Detection - Refinements: Refinements - HLAs Installed
			END
	END

	ACTION_IF NOT VARIABLE_IS_SET "sr_state" THEN BEGIN //Detection - Spell Revisions: Checks
		ACTION_IF NOT MOD_IS_INSTALLED ~SPELL_REV/SETUP-SPELL_REV.TP2~ ~0~ THEN BEGIN //Detection - Spell Revisions: Check if Spell Revisions is not installed
			OUTER_SET "sr_state" = 0 //Variable - "sr_state": set to SR not installed
			PRINT @141 //Detection - Spell Revisions: Spell Revisions is not Installed
		END
			ELSE BEGIN
				OUTER_SET "sr_state" = 1 //Variable - "sr_state": set to SR installed
				PRINT @142 //Detection - Spell Revisions: Spell Revisions Installed
				LOAD_TRA ~FG_Kits\languages\english\setup-sr.tra~
			END
	END

	COPY_EXISTING ~25stweap.2da~ ~override~
		ACTION_IF FILE_SIZE ~override\25stweap.2da~ 27 = 1 THEN BEGIN
			COPY ~FG_Kits\!BaseItems\25stweap.2da~ ~override~
		END
	
END

VERSION ~v1~
AUTO_TRA ~FG_Kits\languages\%s~
LANGUAGE ~English~
         ~english~
         ~FG_Kits\languages\english\setup.tra~
LANGUAGE ~Schinese~
         ~schinese~
         ~FG_Kits\languages\schinese\setup.tra~

