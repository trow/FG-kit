		COPY ~FG_Kits\TArcaTri\FGKATS41.bam~ ~override~ //Trickster: Ability 4 - Arcane Trick: Level 4 - Clear BAM
		COPY ~FG_Kits\TArcaTri\FGKATS42.bam~ ~override~ //Trickster: Ability 4 - Arcane Trick: Level 4 - Stone BAM

	COPY ~FG_Kits\TArcaTri\FGKATS5.spl~ ~override~ //Trickster: Ability 5 - Arcane Trick: Level 5
