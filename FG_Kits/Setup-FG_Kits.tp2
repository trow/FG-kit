/*
BEGIN @70100000 DESIGNATED 701 //Component: Sorcerer Kits - Tamed Sorcerer
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet iwdee~ @103

	COPY ~FG_Kits\STameSor\FGKSTSr.2da~ ~override~
	
	ACTION_IF GAME_IS ~bgee eet~ THEN BEGIN  //Set bio_entry for fl#add_kit_ee macro 
		OUTER_SET "bio_entry" = 31495  //Variable - "bio_entry": set to BG1 Sorcerer bio string
	END
		ELSE BEGIN
			ACTION_IF GAME_IS ~bg2ee~ THEN BEGIN
				OUTER_SET "bio_entry" = "blank" //Variable - "bio_entry": set to "blank"
			END
				ELSE BEGIN
					OUTER_SET "bio_entry" = 40284 //Variable - "bio_entry": set to IWD Sorcerer bio String
				END
		END
	
	COPY_EXISTING ~LuMa0.2da~ ~override\LuKTS.2da~
		COUNT_2DA_COLS "lucol" //Variable - "lucol": Count number of Lu.2da columns
			COUNT_2DA_ROWS "lucol" "lurow" //Variable - "lurow": Count number of Lu.2da rows
				SET "lurow1" = ("lurow" + 1) //Variable - "lurow1": Set to existing rows +1
				SET "lucol1" = ("lucol" - 1) //Variable - "lucol1": Set to existing rows -1
					REMOVE_2DA_ROW "lurow" "lucol1"
						INSERT_2DA_ROW "lurow" "lucol1" ~%lurow%      GA_FGKSEr9     *          *         1         99         1            *            *             *~
	
	ADD_KIT ~FGKSTameSor~ //Kit: Internal Name
		//BG1 Proficiency			SMALL_SWORD LARGE_SWORD BLUNT	    MISSILE	 	BOW		    SPIKED	    AXE		 	SPEAR
