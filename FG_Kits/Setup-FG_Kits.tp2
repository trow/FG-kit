			SET probability1 = "100" //Variable - "probability1": Set to 100
			SET probability2 = "0" //Variable - "probability2": Set to 0
			SPRINT resource ~FGKATS2~ //Variable - "resource": Set to ~FGKATS2~
			SET dicenumber = "0" //Variable - "dicenumber": Set to 0
			SET dicesize = "0" //Variable - "dicesize": Set to 0
			SET savingthrow = "0" //Variable - "savingthrow": Set to 0
			SET savebonus = "0" //Variable - "savebonus": Set to 0
			SET insert_point = "0" //Variable - "insert_point": Set to 0 (Inject at start) - not actually working?
				LAUNCH_PATCH_MACRO ~ADD_ITEM_EQEFFECT~ //Trickster: Passive 1 - Restrict Tricks - Add restrict effect to items
			SET opcode = "177" //Variable - "opcode": Set to 177 (Use EFF File)
