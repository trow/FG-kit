		COPY ~FG_Kits\TArcaTri\FGKATS52.bam~ ~override~ //Trickster: Ability 5 - Arcane Trick: Level 5 - Stone BAM

	COPY ~FG_Kits\TArcaTri\FGKATX1.spl~ ~override~ //Trickster: High Level Ability - Arcane Trick: Level 6
		SAY NAME1 @50100017 //Trickster: High Level Ability - Arcane Trick: Level 6 - Name
		SAY UNIDENTIFIED_DESC @50100018 //Trickster: High Level Ability - Arcane Trick: Level 6 - Description
		COPY ~FG_Kits\TArcaTri\FGKATX11.bam~ ~override~ //Trickster: High Level Ability - Arcane Trick: Level 6 - Clear BAM
		COPY ~FG_Kits\TArcaTri\FGKATX12.bam~ ~override~ //Trickster: High Level Ability - Arcane Trick: Level 6 - Stone BAM
		
	COPY ~FG_Kits\TArcaTri\FGKATS1.eff~ ~override~ //Trickster: Passive 1 - Restrict Tricks - Restriction effect
		 ~FG_Kits\TArcaTri\FGKATS2.eff~ ~override~ //Trickster: Passive 1 - Restrict Tricks - Restriction effect
		 ~FG_Kits\TArcaTri\FGKATS3.eff~ ~override~ //Trickster: Passive 1 - Restrict Tricks - Restriction effect
		 ~FG_Kits\TArcaTri\FGKATS4.eff~ ~override~ //Trickster: Passive 1 - Restrict Tricks - Restriction effect
		 ~FG_Kits\TArcaTri\FGKATS5.eff~ ~override~ //Trickster: Passive 1 - Restrict Tricks - Restriction effect
		 ~FG_Kits\TArcaTri\FGKATX1.eff~ ~override~ //Trickster: Passive 1 - Restrict Tricks - Restriction effect
			WRITE_LONG 0x1c RESOLVE_STR_REF (@50100006) //Trickster: Passive 1 - Restrict Tricks - Add effect string
		
	COPY_EXISTING ~kitlist.2da~ ~override~ //Trickster: Obtain kit ID code
		COUNT_2DA_COLS "kitcol" //Variable - "kitcol": Count number of kitlist.2da columns
			COUNT_2DA_ROWS "kitcol" "kitrow" //Variable - "kitrow": Count number of kitlist.2da rows
				SET "kitcol1" = ("kitcol" - 1) //Variable - "kitcol1": Set to existing columns
				SET "kitrow1" = ("kitrow" - 1) //Variable - "kitrow1": Set to existing rows -1
				READ_2DA_ENTRY "kitrow1" "kitcol1" "kitcol" "kitids" //Variable - "kitids": Read 2da entry to obtain Kit Id
		
	COPY_EXISTING_REGEXP ~.*\.itm~ ~override~ //Trickster: Passive 1 - Restrict Tricks 
		READ_LONG 0x18 "item_flags" //Variable - "item_flags": Set to item flags
		READ_SHORT 0x1c "item_type" //Variable - "item_flags": Set to item type
		READ_LONG 0x1e "item_exclusion" //Variable - "item_exclusion": Set to item usability
		READ_BYTE 0x29 "item_exclusion_kit1" //Variable - "item_proficiency": Set to item kit usability
		PATCH_IF (
				(
				(("item_flags" BAND 0b00000000000000000000000000000100) = 0b00000000000000000000000000000100) OR
				(("item_flags" BAND 0b00000000000000000000000000001000) = 0b00000000000000000000000000001000))
			AND
				(
				("item_type" = "2")
				)
			AND
				(
				(("item_exclusion" BAND 0b00000000010000000000000000000000) = 0b00000000000000000000000000000000)
				)
			AND
				(
				(("item_exclusion_kit1" BAND 0b00100000) = 0b00100000))
			AND NOT
				(
				("item_exclusion" BAND 0b11111111111111111111111111111111) = 0b00000000000000000000000000000000)) //Trickster: Passive 1 - Restrict Tricks - Search for items with ((DROPPABLE) or (DISPLAYABLE)), (ARMOR type), (usable by single-class thieves), (unusable by Avengers) and without (usable by everyone)
			THEN BEGIN
			SET opcode = "177" //Variable - "opcode": Set to 177 (Use EFF File)
			SET target = "1" //Variable - "target": Set to 1 (Target Self)
			SET power = "0" //Variable - "power: Set to 0 (Item Restricted from parameters)
			SET parameter1 = "kitids" //Variable - "parameter1": Set to "kitids" (Kit ID)
			SET parameter2 = "9" //Variable - "parameter2": Set to 9 (kit.ids)
			SET timing = "2" //Variable - "timing": Set to 2 (Instant/While Equipped)
			SET resist_dispel = "0" //Variable - "resist_dispel": Set to 0 (No dispel/bypass resistant)
			SET duration = "0" //Variable - "duration": Set to 0
			SET probability1 = "100" //Variable - "probability1": Set to 100
			SET probability2 = "0" //Variable - "probability2": Set to 0
			SPRINT resource ~FGKATS1~ //Variable - "resource": Set to ~FGKATS1~
			SET dicenumber = "0" //Variable - "dicenumber": Set to 0
			SET dicesize = "0" //Variable - "dicesize": Set to 0
			SET savingthrow = "0" //Variable - "savingthrow": Set to 0
			SET savebonus = "0" //Variable - "savebonus": Set to 0
			SET insert_point = "0" //Variable - "insert_point": Set to 0 (Inject at start) - not actually working?
				LAUNCH_PATCH_MACRO ~ADD_ITEM_EQEFFECT~ //Trickster: Passive 1 - Restrict Tricks - Add restrict effect to items
			SET opcode = "177" //Variable - "opcode": Set to 177 (Use EFF File)
